{
  "name": "founder-retropick-gtm-os",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first tenant-isolated GTM workflow core; offline by default",
  "packageManager": "pnpm@12.4.2",
  "engines": { "node": ">=24.11.0 <25" },
  "bin": { "gtm": "gtm" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters --noImplicitReturns",
    "test": "pnpm build && vitest run",
    "gtm": "node dist/packages/cli/src/index.js",
    "check": "pnpm lint && pnpm test && python3 scripts/validate_scaffold.py && python3 -m unittest discover -s tests -v && python3 scripts/security_audit.py --json"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
