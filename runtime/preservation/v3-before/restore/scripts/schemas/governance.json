{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "skill": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 1024
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "compatibility": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S",
          "maxLength": 500
        },
        "metadata": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "allowed-tools": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "stage": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "skill": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "tool": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "output": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "acceptance": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "skill",
        "tool",
        "input",
        "output",
        "acceptance"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "trigger": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "owner": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "risk_tier": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "outputs": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "retry_policy": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "resume_checkpoint": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "compensation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tenant": {
          "const": "REQUIRED_AT_RUNTIME"
        },
        "inputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/stage"
          }
        },
        "approval_gate": {
          "const": "HUMAN_APPROVAL_REQUIRED_PER_EXTERNAL_ACTION"
        },
        "cost_policy": {
          "const": "DEFAULT_ZERO_PAID_API_SPEND"
        },
        "metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "terminal_states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "COMPLETED_LOCAL",
              "AWAITING_APPROVAL",
              "BLOCKED",
              "FAILED",
              "CANCELLED"
            ]
          }
        }
      },
      "required": [
        "id",
        "description",
        "trigger",
        "owner",
        "risk_tier",
        "outputs",
        "retry_policy",
        "resume_checkpoint",
        "compensation",
        "version",
        "tenant",
        "inputs",
        "stages",
        "approval_gate",
        "cost_policy",
        "metrics",
        "terminal_states"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "initial": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        },
        "default_on_error": {
          "const": "blocked"
        },
        "approval_rule": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "initial",
        "states",
        "default_on_error",
        "approval_rule"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "enum": [
            "retropick",
            "founder"
          ]
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "expected_x_handle": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "source_of_truth": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "status": {
          "const": "provisional_requires_first_party_verification"
        },
        "publication_enabled": {
          "const": false
        }
      },
      "required": [
        "id",
        "display_name",
        "expected_x_handle",
        "source_of_truth",
        "status",
        "publication_enabled"
      ],
      "additionalProperties": false
    },
    "tokens": {
      "type": "object",
      "properties": {
        "_status": {
          "const": "PLACEHOLDER_NOT_OFFICIAL"
        },
        "tenant": {
          "enum": [
            "retropick",
            "founder"
          ]
        },
        "font_family": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "colors": {
          "type": "object",
          "minProperties": 3,
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          }
        },
        "ratios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "16:9",
              "1:1",
              "9:16"
            ]
          }
        }
      },
      "required": [
        "_status",
        "tenant",
        "font_family",
        "colors",
        "ratios"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "object",
      "properties": {
        "tenant": {
          "enum": [
            "retropick",
            "founder"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "statement": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "classification": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source_uri": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "source_revision": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "observed_at": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "expires_at": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "verification_method": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "review_status": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "risk_tier": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "tenant": {
                "enum": [
                  "retropick",
                  "founder"
                ]
              },
              "permitted_channels": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              },
              "owner_approval": {
                "type": [
                  "object",
                  "null"
                ]
              }
            },
            "required": [
              "claim_id",
              "statement",
              "classification",
              "source_uri",
              "source_revision",
              "observed_at",
              "expires_at",
              "verification_method",
              "review_status",
              "risk_tier",
              "tenant",
              "permitted_channels",
              "owner_approval"
            ],
            "additionalProperties": false
          }
        },
        "approval_required": {
          "const": true
        }
      },
      "required": [
        "tenant",
        "claims",
        "approval_required"
      ],
      "additionalProperties": false
    }
  }
}
